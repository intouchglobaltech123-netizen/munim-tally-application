# Local development uses the unix socket (peer auth, no password).
# DATABASE_URL=postgres:///munim?host=/var/run/postgresql

# Production
# DATABASE_URL=postgres://user:pass@host:5432/munim

PORT=8080

# --- Phone sign-in ----------------------------------------------------------
# Set FIREBASE_PROJECT_ID and this server switches to real phone sign-in, and
# CLOSES the development OTP route (410). See docs/22-firebase.md.
# FIREBASE_PROJECT_ID=munim-xxxxx
# FIREBASE_API_KEY=AIza...
# FIREBASE_APP_ID=1:123...:web:abc...
# FIREBASE_AUTH_DOMAIN=munim-xxxxx.firebaseapp.com

# DEVELOPMENT ONLY, and ignored once Firebase is configured. A fixed OTP in
# production means anyone owns every account.
OTP_FIXED_CODE=123456

# Your staff account for /admin
MUNIM_OPERATOR_PHONE=+919000000001

# What the pairing QR encodes
PAIR_LINK_BASE=https://munim.app/p/

# Encryption at rest for backups, which contain the whole of a customer's books.
#
# Generate one with:  openssl rand -hex 32
# Keep a copy somewhere safe and separate from the database - without this key,
# backups written with it can never be opened again. The server refuses to start
# with NODE_ENV=production while this is unset.
MUNIM_ENCRYPTION_KEY=
