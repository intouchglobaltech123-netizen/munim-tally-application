# Flat node_modules, not pnpm's symlinked store.
#
# pnpm's default puts every package under a directory named after its full
# dependency graph, e.g.
#   node_modules/.pnpm/react-native-screens@4.16.0_react-native@0.81.5_@babel+core@7.29.7_...
# On Windows that pushes real build paths past MAX_PATH (260 chars). The Android
# NDK build then fails with a error that names none of this:
#   CreateProcess error=2, The system cannot find the file specified
#     ...\cxx\Debug\6m3x136r\logs\arm64-v8a\prefab_command.bat   (276 chars)
#
# Hoisted brings that same path down to 142 characters. It is also what React
# Native expects: its Gradle plugins and Metro both assume a flat layout.
node-linker=hoisted

# Keep the store on the same drive as the project so linking stays cheap.
store-dir=C:\Users\User\.pnpm-store\v3
