# EAS archives from the workspace root in a monorepo, so this file - not the one
# in apps/mobile - is what it reads.
#
# node_modules must never be uploaded: EAS installs from the lockfile on its own
# servers, so it is wasted upload time, and in this workspace it is fatal.
# apps/web/node_modules contains a corrupt pnpm entry (@firebase/messaging/sw)
# that neither Windows nor WSL can read or delete, and the archiver dies on it.
node_modules/
**/node_modules/

# Nothing outside the mobile app belongs in an Android build.
apps/api/
apps/web/
connector/
connector-ps/
docs/
scripts/
tools/
mock-tally/

*.log
.env
.env.local
**/.expo/
**/dist/
**/.next/

# Signing keys never leave this machine, and certainly never go into a build
# upload. The real copy lives on Expo's servers; any local one is a convenience.
*.jks
*.keystore
*.p12

# Generated by `expo prebuild` for local USB builds. EAS generates its own, and
# an out-of-date copy here would silently override the app config.
apps/mobile/android/
apps/mobile/ios/
